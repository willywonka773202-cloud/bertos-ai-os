# Copy to .env.local and fill in values for your environment.

# ===== BertOS deployment =====
# Use "cloud" on Vercel and "local" on your development machine.
BERTOS_DEPLOYMENT_MODE=local
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protects /api/cli/* routes for the terminal CLI.
# Generate a long random value and use the same value in bertos init.
BERTOS_AGENT_SECRET=

# ===== Ollama Pro / Ollama Cloud =====
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=gpt-oss:120b-cloud
OLLAMA_LOCAL_FALLBACK=qwen2.5-coder:latest

# Required for deployed Vercel cloud mode.
OLLAMA_API_KEY=

# ===== Local CLI bridge daemon =====
BERTOS_DAEMON_HOST=127.0.0.1
BERTOS_DAEMON_PORT=8787

# ===== Optional metered API providers =====
# Disabled by default so BertOS does not create surprise API billing.
ENABLE_API_PROVIDERS=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ===== Future integrations =====
HERMES_API_URL=
HERMES_API_KEY=
COMPOSIO_API_KEY=
